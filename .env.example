# Copy this file to ".env" for local development. Never commit a real .env or secret.
# The placeholder below is for local development only; replace it with a private random value in production.

DATABASE_URL=sqlite:///./sthira.db
STORAGE_DIR=./storage
SECRET_KEY=replace-with-a-private-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true
